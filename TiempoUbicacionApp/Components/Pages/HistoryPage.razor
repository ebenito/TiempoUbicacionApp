@page "/history"
@using Microsoft.Maui.Devices
@using TiempoUbicacionApp.Models
@using TiempoUbicacionApp.Services

@inject IAlertService AlertService
@inject BackupService BackupService
@inject LocationDatabaseService LocationDatabaseService

@if (_editingEntry is not null)
{
    <EditEntryPage Entry="_editingEntry"
                   OnBack="OnEditBack"
                   OnSaved="OnEntrySaved" />
}
else if (_isAndroid)
{
    <AndroidHistory Entries="entries"
                    OnBackup="DoBackup"
                    OnRestore="DoRestore"
                    OnRefresh="RefreshHistory"
                    OnEdit="OnEditRequested"
                    OnDelete="OnDeleteRequested" />
}
else
{
    <DesktopHistory Entries="entries"
                    OnBackup="DoBackup"
                    OnRestore="DoRestore"
                    OnRefresh="RefreshHistory"
                    OnEdit="OnEditRequested"
                    OnDelete="OnDeleteRequested" />
}

@code {
    private bool _isAndroid;
    private List<LocationEntry> entries = new();
    private LocationEntry? _editingEntry;

    protected override void OnInitialized()
    {
        _isAndroid = DeviceInfo.Current.Platform == DevicePlatform.Android;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        try
        {
            entries = await LocationDatabaseService.GetAllEntriesAsync();
        }
        catch (Exception ex)
        {
            await AlertService.ShowToastAsync($"Error cargando historial: {ex.Message}");
            entries = new List<LocationEntry>();
        }
    }

    private async Task DoBackup()
    {
        await BackupService.ShareDatabaseAsync();
    }

    private async Task DoRestore()
    {
        var restored = await BackupService.RestoreDatabaseAsync();
        if (restored)
        {
            await LoadEntriesAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshHistory()
    {
        await LoadEntriesAsync();
        StateHasChanged();
        await AlertService.ShowToastAsync("🔄 Histórico actualizado");
    }

    // ── Editar ────────────────────────────────────────────────────────────

    private void OnEditRequested(LocationEntry entry)
    {
        _editingEntry = entry;
        StateHasChanged();
    }

    private async Task OnEditBack()
    {
        _editingEntry = null;
        StateHasChanged();
    }

    private async Task OnEntrySaved()
    {
        await LoadEntriesAsync();
    }

    // ── Borrar ────────────────────────────────────────────────────────────

    private async Task OnDeleteRequested(LocationEntry entry)
    {
        bool confirmed = await Helpers.DialogHelper.ShowConfirmAsync(
            "Borrar registro",
            $"¿Deseas eliminar el registro del {entry.FechaActual}? Esta acción no se puede deshacer.",
            "Sí, borrar",
            "Cancelar");

        if (!confirmed) return;

        try
        {
            await LocationDatabaseService.DeleteEntryAsync(entry);
            await LoadEntriesAsync();
            StateHasChanged();
            await AlertService.ShowToastAsync("🗑 Registro eliminado.");
        }
        catch (Exception ex)
        {
            await AlertService.ShowToastAsync($"Error al borrar: {ex.Message}");
        }
    }
}
